# Liberty Surveys Environment Variables
# Copy this file to .env.local and fill in your values
#
# Domain: libertysurveys.com
# AWS Region: us-east-1
# Daily send time: 7:00 AM ET

# =============================================================================
# DATABASE (Aurora DSQL)
# =============================================================================

# PostgreSQL connection string for Aurora DSQL (us-east-1)
# Format: postgres://user:password@hostname:port/database
DATABASE_URL=postgres://admin:password@your-dsql-cluster.us-east-1.dsql.amazonaws.com:5432/liberty_surveys

# Set to "false" to disable SSL (not recommended for production)
DATABASE_SSL=true

# For local development without a database, set this to "true" to use mock data
# NOTE: Admin test credentials (admin@example.com/admin123) ONLY work when USE_MOCK_DB=true
USE_MOCK_DB=false

# =============================================================================
# CUSTOMER.IO
# =============================================================================
# Workspace: "Liberty Surveys" (US region - track-api.customer.io)
# Sending domain: libertysurveys.com
# Sender: "Liberty Surveys" <polls@libertysurveys.com>

# Track API credentials (Basic Auth)
# Find these in Customer.io: Settings > API & Webhook Credentials
CUSTOMERIO_SITE_ID=your_site_id
CUSTOMERIO_API_KEY=your_api_key

# App API key (Bearer token) for transactional sends
# Create in Customer.io: Settings > API & Webhook Credentials > App API Keys
CUSTOMERIO_APP_API_KEY=app_your_api_key

# Environment ID (for API-triggered broadcasts)
# Find this in your Customer.io workspace URL or settings
CUSTOMERIO_ENVIRONMENT_ID=1

# Campaign ID for the daily poll broadcast (create this in Customer.io)
CUSTOMERIO_BROADCAST_CAMPAIGN_ID=

# Campaign ID for the nightly recap broadcast (create this in Customer.io)
CUSTOMERIO_RECAP_CAMPAIGN_ID=

# Transactional message ID for confirmation emails (create this in Customer.io)
CUSTOMERIO_CONFIRM_MESSAGE_ID=

# =============================================================================
# SECURITY
# =============================================================================

# Secret for signing vote links (use a strong random string, min 32 chars)
VOTE_SIGNING_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Secret for signing confirmation links
CONFIRM_SIGNING_SECRET=change-this-to-another-secure-random-string

# Secret for signing unsubscribe links
UNSUBSCRIBE_SIGNING_SECRET=change-this-to-yet-another-secure-string

# JWT secret for admin sessions (min 32 chars)
JWT_SECRET=change-this-to-a-secure-jwt-secret-min-32-chars

# =============================================================================
# APPLICATION
# =============================================================================

# Base URL of your application (used for generating links in emails)
# Local development: http://localhost:3000
# Production: https://libertysurveys.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# =============================================================================
# AWS (for production deployment)
# =============================================================================

# AWS Region (all services in us-east-1)
AWS_REGION=us-east-1

# AWS credentials (typically provided by Amplify/Lambda automatically)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# =============================================================================
# xAI / GROK API (LLM for poll generation)
# =============================================================================

# xAI API Key (get from https://console.x.ai)
XAI_API_KEY=your_xai_api_key

# xAI model for poll generation (default: grok-4.7)
# grok-4.7 is the flagship model with 500k context
XAI_MODEL=grok-4.7

# xAI model for bias checking (default: grok-4.7 with low reasoning)
XAI_BIAS_CHECK_MODEL=grok-4.7

# =============================================================================
# NEWS API (for automated poll generation)
# =============================================================================

# NewsAPI.org API key (https://newsapi.org)
# Free tier: 100 requests/day, Production: $449/month for 100k requests
NEWSAPI_API_KEY=your_newsapi_key

# Mock news data for local development (set to "true" to skip API calls)
USE_MOCK_NEWS=false

# Mock LLM for local development (set to "true" to skip Bedrock calls)
USE_MOCK_LLM=false

# =============================================================================
# NIGHTLY RECAP
# =============================================================================

# Minimum votes required to send recap (default: 10)
RECAP_MIN_VOTES=10

# =============================================================================
# SCHEDULED JOBS (EventBridge Scheduler)
# =============================================================================

# Secret for authenticating scheduled job requests (optional but recommended)
# Generate with: openssl rand -hex 32
SCHEDULER_SECRET=

# Schedule (configured in EventBridge):
# - Poll generation: 5:00 AM ET daily - cron(0 5 * * ? *) America/New_York
# - Daily poll send: 7:00 AM ET daily - cron(0 7 * * ? *) America/New_York  
# - Nightly recap: 8:00 PM ET daily - cron(0 20 * * ? *) America/New_York

# =============================================================================
# NOTES
# =============================================================================
#
# For LOCAL DEVELOPMENT:
# 1. Set USE_MOCK_DB=true to run without a database
# 2. Leave Customer.io credentials empty to use mock mode
# 3. Set USE_MOCK_NEWS=true and USE_MOCK_LLM=true for mock poll generation
# 4. Admin login: admin@example.com / admin123 (ONLY works with USE_MOCK_DB=true)
# 5. Run manual generation: npm run generate
# 6. Run recap preview: npm run recap:preview
#
# For PRODUCTION (libertysurveys.com):
# 1. Set USE_MOCK_DB=false (or remove it)
# 2. Set DATABASE_URL to your Aurora DSQL cluster (us-east-1)
# 3. Set all Customer.io credentials ("Liberty Surveys" workspace, US region)
# 4. Set NEWSAPI_API_KEY for news fetching
# 5. Set XAI_API_KEY for Grok-powered poll generation
# 6. Generate secure random strings for all signing secrets
# 7. Set NEXT_PUBLIC_BASE_URL=https://libertysurveys.com
# 8. Create admin user in database (NOT hardcoded credentials)
# 9. Configure EventBridge Schedulers (see schedule notes above)
#
# ESTIMATED MONTHLY COSTS:
# - NewsAPI.org: $449/month (production plan, 100k requests)
# - xAI Grok API: ~$20-60/month (~30 polls/month, grok-4.7 at $2/1M in, $6/1M out)
# - Aurora DSQL: Pay-per-use
# - Amplify Hosting: Pay-per-use
#
# GENERATING SECURE SECRETS:
# openssl rand -hex 32
# or
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# CREATING PRODUCTION ADMIN USER:
# Use the migration script or run SQL:
# INSERT INTO admin_users (id, email, password_hash, created_at)
# VALUES ('01...ulid', 'your@email.com', '<bcrypt_hash>', NOW());
# Generate password hash: npx bcryptjs hash "your-secure-password"
