# Liberty Surveys Environment Variables
# Copy this file to .env.local and fill in your values
#
# Domain: libertysurveys.com
# AWS Region: us-east-1
# Daily send time: 7:00 AM ET

# =============================================================================
# DATABASE (Aurora DSQL with IAM Authentication)
# =============================================================================
# Aurora DSQL uses IAM auth - no static passwords in connection strings.
# The app uses @aws/aurora-dsql-node-postgres-connector to mint short-lived tokens.
# AWS credentials come from the Amplify WEB_COMPUTE runtime automatically.

# DSQL cluster endpoint (required in production)
# Example: lzuf446jlkxw3jqtiby3laba4u.dsql.us-east-1.on.aws
DSQL_ENDPOINT=

# DSQL user (default: admin for IAM admin auth)
DSQL_USER=admin

# DSQL region (defaults to AWS_REGION or us-east-1)
DSQL_REGION=us-east-1

# For local development without a database, set this to "true" to use mock data
# NOTE: Admin test credentials (admin@example.com/admin123) ONLY work when USE_MOCK_DB=true
USE_MOCK_DB=false

# DEPRECATED: DATABASE_URL with password auth does NOT work with Aurora DSQL.
# Use DSQL_ENDPOINT + IAM auth instead. Keeping for reference only.
# DATABASE_URL=postgres://admin:password@cluster.dsql.us-east-1.on.aws:5432/postgres

# =============================================================================
# CUSTOMER.IO
# =============================================================================
# Workspace: "Liberty Surveys" (US region - track-api.customer.io)
# Sending domain: libertysurveys.com
# Sender: "Liberty Surveys" <polls@libertysurveys.com>

# Site ID (non-secret, safe to commit)
CUSTOMERIO_SITE_ID=dd09dc6a20a7e9534d2e

# Track API Key (SECRET - set in Amplify Console, not here)
CUSTOMERIO_API_KEY=

# App API Key for transactional/broadcast sends (SECRET - set in Amplify Console)
CUSTOMERIO_APP_API_KEY=

# Environment ID (non-secret)
CUSTOMERIO_ENVIRONMENT_ID=237678

# Campaign ID for the daily poll broadcast (non-secret)
CUSTOMERIO_BROADCAST_CAMPAIGN_ID=8

# Campaign ID for the nightly recap broadcast (non-secret)
CUSTOMERIO_RECAP_CAMPAIGN_ID=9

# Transactional message ID for confirmation emails (non-secret)
CUSTOMERIO_CONFIRM_MESSAGE_ID=2

# =============================================================================
# SECURITY
# =============================================================================

# Secret for signing vote links (use a strong random string, min 32 chars)
VOTE_SIGNING_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Secret for signing confirmation links
CONFIRM_SIGNING_SECRET=change-this-to-another-secure-random-string

# Secret for signing unsubscribe links
UNSUBSCRIBE_SIGNING_SECRET=change-this-to-yet-another-secure-string

# JWT secret for admin sessions (min 32 chars)
JWT_SECRET=change-this-to-a-secure-jwt-secret-min-32-chars

# =============================================================================
# APPLICATION
# =============================================================================

# Base URL of your application (used for generating links in emails)
# Local development: http://localhost:3000
# Production: https://libertysurveys.com (or Amplify default URL until custom domain)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Alternatively for production before custom domain is set up:
# NEXT_PUBLIC_BASE_URL=https://<branch>.<app-id>.amplifyapp.com

# Node environment
NODE_ENV=development

# =============================================================================
# AWS (for production deployment)
# =============================================================================

# AWS Region (all services in us-east-1)
AWS_REGION=us-east-1

# AWS credentials (typically provided by Amplify/Lambda automatically)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# =============================================================================
# xAI / GROK API (LLM for poll generation)
# =============================================================================

# xAI API Key (get from https://console.x.ai)
XAI_API_KEY=your_xai_api_key

# xAI model for poll generation (default: grok-4.7)
# grok-4.7 is the flagship model with 500k context
XAI_MODEL=grok-4.7

# xAI model for bias checking (default: grok-4.7 with low reasoning)
XAI_BIAS_CHECK_MODEL=grok-4.7

# =============================================================================
# NEWS SOURCES (RSS feeds + xAI web search)
# =============================================================================

# Mock news data for local development (set to "true" to skip API calls)
USE_MOCK_NEWS=false

# Mock LLM for local development (set to "true" to skip xAI calls)
USE_MOCK_LLM=false

# Optional: Custom RSS sources as JSON array
# Format: [{"name":"Source","domain":"example.com","politicalLean":"center","rssUrl":"https://..."}]
# If not set, uses default balanced set of 22 sources across the political spectrum
# NEWS_SOURCES_JSON=

# =============================================================================
# NIGHTLY RECAP
# =============================================================================

# Minimum votes required to send recap (default: 10)
RECAP_MIN_VOTES=10

# =============================================================================
# SCHEDULED JOBS (EventBridge Scheduler)
# =============================================================================

# Secret for authenticating scheduled job requests (optional but recommended)
# Generate with: openssl rand -hex 32
SCHEDULER_SECRET=

# Schedule (configured in EventBridge):
# - Poll generation: 5:00 AM ET daily - cron(0 5 * * ? *) America/New_York
# - Daily poll send: 7:00 AM ET daily - cron(0 7 * * ? *) America/New_York  
# - Nightly recap: 8:00 PM ET daily - cron(0 20 * * ? *) America/New_York

# =============================================================================
# GOOGLE ADSENSE
# =============================================================================

# AdSense Publisher ID (already in public/ads.txt)
# pub-1375050605480919

# Ad slot IDs from AdSense console (create responsive display units)
# Leave empty to disable ads on that page; dev mode shows placeholders
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_POLL=
NEXT_PUBLIC_ADSENSE_SLOT_ARCHIVE=

# =============================================================================
# NOTES
# =============================================================================
#
# For LOCAL DEVELOPMENT:
# 1. Set USE_MOCK_DB=true to run without a database
# 2. Leave Customer.io credentials empty to use mock mode
# 3. Set USE_MOCK_NEWS=true and USE_MOCK_LLM=true for mock poll generation
# 4. Admin login: admin@example.com / admin123 (ONLY works with USE_MOCK_DB=true)
# 5. Run manual generation: npm run generate
# 6. Run recap preview: npm run recap:preview
#
# For PRODUCTION (libertysurveys.com):
# 1. Set USE_MOCK_DB=false (or remove it)
# 2. Set DATABASE_URL to your Aurora DSQL cluster (us-east-1)
# 3. Set all Customer.io credentials ("Liberty Surveys" workspace, US region)
# 4. Set XAI_API_KEY for Grok-powered poll generation and web search
# 5. Generate secure random strings for all signing secrets
# 6. Set NEXT_PUBLIC_BASE_URL=https://libertysurveys.com
# 7. Create admin user in database (NOT hardcoded credentials)
# 8. Configure EventBridge Schedulers (see schedule notes above)
#
# ESTIMATED MONTHLY COSTS:
# - xAI Grok API: ~$30-80/month (polls + web search, grok-4.7 at $2/1M in, $6/1M out)
# - Aurora DSQL: Pay-per-use
# - Amplify Hosting: Pay-per-use
# - RSS feeds: Free
#
# GENERATING SECURE SECRETS:
# openssl rand -hex 32
# or
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# CREATING PRODUCTION ADMIN USER:
# Use the migration script or run SQL:
# INSERT INTO admin_users (id, email, password_hash, created_at)
# VALUES ('01...ulid', 'your@email.com', '<bcrypt_hash>', NOW());
# Generate password hash: npx bcryptjs hash "your-secure-password"
