# Liberty Surveys Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# DATABASE (Aurora DSQL)
# =============================================================================

# PostgreSQL connection string for Aurora DSQL
# Format: postgres://user:password@hostname:port/database
DATABASE_URL=postgres://admin:password@your-dsql-cluster.us-east-1.dsql.amazonaws.com:5432/liberty_surveys

# Set to "false" to disable SSL (not recommended for production)
DATABASE_SSL=true

# For local development without a database, set this to "true" to use mock data
USE_MOCK_DB=false

# =============================================================================
# CUSTOMER.IO
# =============================================================================

# Track API credentials (Basic Auth)
# Find these in Customer.io: Settings > API & Webhook Credentials
CUSTOMERIO_SITE_ID=your_site_id
CUSTOMERIO_API_KEY=your_api_key

# App API key (Bearer token) for transactional sends
# Create in Customer.io: Settings > API & Webhook Credentials > App API Keys
CUSTOMERIO_APP_API_KEY=app_your_api_key

# Environment ID (for API-triggered broadcasts)
# Find this in your Customer.io workspace URL or settings
CUSTOMERIO_ENVIRONMENT_ID=1

# Campaign ID for the daily poll broadcast (create this in Customer.io)
CUSTOMERIO_BROADCAST_CAMPAIGN_ID=

# Transactional message ID for confirmation emails (create this in Customer.io)
CUSTOMERIO_CONFIRM_MESSAGE_ID=

# =============================================================================
# SECURITY
# =============================================================================

# Secret for signing vote links (use a strong random string, min 32 chars)
VOTE_SIGNING_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Secret for signing confirmation links
CONFIRM_SIGNING_SECRET=change-this-to-another-secure-random-string

# Secret for signing unsubscribe links
UNSUBSCRIBE_SIGNING_SECRET=change-this-to-yet-another-secure-string

# JWT secret for admin sessions (min 32 chars)
JWT_SECRET=change-this-to-a-secure-jwt-secret-min-32-chars

# =============================================================================
# APPLICATION
# =============================================================================

# Base URL of your application (used for generating links in emails)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# =============================================================================
# AWS (for production deployment)
# =============================================================================

# AWS Region
# AWS_REGION=us-east-1

# These are typically provided by Amplify/Lambda automatically
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =============================================================================
# NOTES
# =============================================================================
#
# For LOCAL DEVELOPMENT:
# 1. Set USE_MOCK_DB=true to run without a database
# 2. Leave Customer.io credentials empty to use mock mode
# 3. The app will log what would be sent to Customer.io
#
# For PRODUCTION:
# 1. Set all Customer.io credentials
# 2. Set DATABASE_URL to your Aurora DSQL cluster
# 3. Generate secure random strings for all signing secrets
# 4. Set NEXT_PUBLIC_BASE_URL to your domain
#
# GENERATING SECURE SECRETS:
# openssl rand -hex 32
# or
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
